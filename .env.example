PORT=5000
NODE_ENV=production
MONGO_USERNAME=signapp
MONGO_PASSWORD=replace-with-a-long-random-password
# Used for local development. Docker Compose builds this automatically from MONGO_USERNAME and MONGO_PASSWORD.
MONGO_URI=mongodb://signapp:replace-with-a-long-random-password@localhost:27017/signapp?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
MAIL_FROM_NAME=Yanisa Sign
MAIL_FROM_EMAIL=tech@yanisa.in
HR_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Optional in production when the frontend and API share one domain.
CLIENT_URL=
APP_URL=https://sign.example.com
STORAGE_PATH=./storage
MAX_PDF_SIZE_MB=20
DEFAULT_SIGN_VALID_DAYS=7
SIGN_CERTIFICATE_ENABLED=true
# Temporary standalone bootstrap credentials. Replace with HRMS SSO/JWT integration.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
