PORT=5000
NODE_ENV=production
# For local development, run MongoDB separately and use its credentials here.
MONGO_URI=mongodb://signapp:replace-with-a-long-random-password@localhost:27017/signapp?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
MAIL_FROM_NAME=Yanisa Sign
MAIL_FROM_EMAIL=tech@yanisa.in
HR_NOTIFICATION_EMAIL=
# --- Outgoing mail --------------------------------------------------------
# ALL email - sign-in codes, invitations, password resets, signature requests
# and completion notices - is sent through the SMTP server configured in the
# app under Administration > Mail and stored in the database.
#
# The SMTP_* and MAIL_FROM_* values below are read ONCE, on the first boot when
# no mail settings row exists yet, to carry an existing deployment over. After
# that they are ignored entirely and can be deleted from your environment.
#
# Deploy order matters: deploy with these still set so the row is seeded, check
# Administration > Mail and send a test, and only then remove them. Removing
# them first leaves an empty, disabled row and no mail goes out until an
# administrator configures it.
#
# Resend: host smtp.resend.com, user "resend", password = your API key.
# AWS SES fallback: host email-smtp.<region>.amazonaws.com with SES SMTP
# credentials (which are not your AWS access keys).
# Port 587 uses STARTTLS, so SMTP_SECURE stays false; set it true only for 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Encrypts the stored SMTP password (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it means re-entering the SMTP password in Administration.
# If unset, a key is derived from JWT_SECRET instead - workable, but it ties
# mail config to the session signing key, so set this explicitly.
SETTINGS_ENCRYPTION_KEY=

# How long Administration > Email log keeps delivery records. These are
# operational data rather than an audit trail, so they age out on their own.
# Set to 0 to keep them for ever.
EMAIL_LOG_RETENTION_DAYS=90
# Optional in production when the frontend and API share one domain.
CLIENT_URL=
APP_URL=https://sign.example.com
STORAGE_PATH=./storage
MAX_PDF_SIZE_MB=20
DEFAULT_SIGN_VALID_DAYS=7
SIGN_CERTIFICATE_ENABLED=true

# --- Organisation and first administrator ---------------------------------
# Seeded on first boot only. The account owns the default company and can then
# invite everyone else from Administration > Users.
COMPANY_NAME=Yanisa
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# --- Sessions --------------------------------------------------------------
# Access token lifetime (in the Authorization header) and refresh token
# lifetime (in an HttpOnly cookie).
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=7

# --- One-time codes --------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
OTP_MAX_PER_WINDOW=5

# --- Email sign-in codes ---------------------------------------------------
# Keys the HMAC that derives each login code's TOTP secret. Rotating it
# invalidates every code that has not been used yet. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional. Keys the HMAC that derives each sign-in code. If unset, a key is
# derived from JWT_SECRET so a deployment that has not added this variable can
# still sign people in - but set it, so rotating JWT_SECRET does not invalidate
# codes that are already in flight.
OTP_SECRET=replace-with-a-long-random-secret
OTP_LOGIN_TTL_MINUTES=5
# Code requests allowed per email address per window.
OTP_LOGIN_MAX_REQUESTS=3
OTP_LOGIN_WINDOW_MINUTES=10

# How long an invitation link stays usable. New users activate from a one-time
# link, not a code - one-time codes are only used for signing in.
INVITE_TOKEN_DAYS=7

# Accounts that sign in on the password alone, with no emailed code
# (comma-separated). Only for an administrator whose address is not a real
# mailbox: a code sent to an inbox nobody reads is a permanent lockout, and
# that account is usually the one that would fix the mail settings.
# Every such sign-in is written to the audit log. Clear this as soon as the
# account has a working address.
MFA_BYPASS_EMAILS=

# --- Sign-in protection ----------------------------------------------------
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# --- Rate limits (requests per 15 minutes, per IP) -------------------------
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_LOGIN=200
RATE_LIMIT_OTP_SEND=15
RATE_LIMIT_OTP_VERIFY=40
